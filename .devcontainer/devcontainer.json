{
  "name": "Kotlin Spring Boot Dev Container",
  "image": "mcr.microsoft.com/devcontainers/java:20-bullseye",
  "customizations": {
    "vscode": {
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-20",
            "path": "/usr/lib/jvm/msopenjdk-20",
            "default": true
          }
        ],
        "kotlin.compiler.jvm.target": "20"
      },
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot-pack",
        "vscjava.vscode-gradle"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "./gradlew --version",
  "remoteUser": "vscode"
}
